<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smartthinh.customttsdictionary"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Cho phep nhin thay tat ca cac goi TTS tren dien thoai (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Man hinh chinh quan ly tu dien va cau hinh -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Man hinh nhat ky hoat dong chi tiet -->
        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="Nhật ký hoạt động" />

        <!-- Provider chia se tep nhat ky (.log) -->
        <provider
            android:name=".util.LogFileProvider"
            android:authorities="com.smartthinh.customttsdictionary.logfileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Dich vu TTS trung gian dong vai tro la mot Engine trong he thong Android -->
        <service
            android:name=".service.ProxyTtsService"
            android:exported="true"
            android:label="@string/tts_engine_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

    </application>

</manifest>
